rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsAccount(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validItem() {
      return request.resource.data.keys().hasAll(['type', 'payload', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['type', 'payload', 'updatedAt'])
        && request.resource.data.type in [
          'session',
          'exercise',
          'routine',
          'weight',
          'settings',
          'draft'
        ]
        && request.resource.data.payload is map
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{uid}/items/{itemId} {
      allow read: if ownsAccount(uid);
      allow create, update: if ownsAccount(uid) && validItem();
      allow delete: if ownsAccount(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
